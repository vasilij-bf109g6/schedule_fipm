<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itemContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/card_background"
    android:elevation="2dp">

    <!-- Время пары -->
    <TextView
        android:id="@+id/classTimeTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="09:00-10:30"
        android:textSize="16sp"
        android:textColor="#2196F3"
        android:layout_marginBottom="4dp"/>

    <!-- Предмет -->
    <TextView
        android:id="@+id/classSubjectTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Математика"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/textPrimary"
        android:layout_marginBottom="8dp"/>

    <!-- Аудитория и преподаватель в одной строке (БЕЗ ИКОНОК) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Аудитория -->
        <TextView
            android:id="@+id/classRoomTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ауд. 101"
            android:textSize="14sp"
            android:textColor="@color/textSecondary"/>

        <!-- Преподаватель -->
        <TextView
            android:id="@+id/classTeacherTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Иванов И.И."
            android:textSize="14sp"
            android:textColor="@color/textSecondary"
            android:gravity="end"/>

    </LinearLayout>

</LinearLayout>