<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Состояние: нажата -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp"/>
            <solid android:color="#BBDEFB"/>  <!-- Светло-голубой -->
        </shape>
    </item>

    <!-- Состояние: выбрана -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp"/>
            <solid android:color="#CCFFFF"/>  <!-- Голубой -->
        </shape>
    </item>

    <!-- Обычное состояние -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp"/>
            <solid android:color="#FFFFFF"/>  <!-- Белый -->
            <stroke
                android:width="2dp"
                android:color="#BBDEFB"/>  <!-- Светло-голубая рамка -->
        </shape>
    </item>

</selector>